# Browser API root. The dev server and production nginx both proxy /api to FastAPI.
VITE_API_URL=/api
# Development only: override the local FastAPI target, e.g. http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000
# Set only for the Cloudflare/Vercel deployment; leave unset for Docker/FastAPI.
# VITE_DEPLOYMENT_TARGET=cloudflare
# Vercel server-side variable (not VITE_): WORKER_API_URL=https://hireflow-api.YOUR_SUBDOMAIN.workers.dev
# Vercel server-only secret WORKSPACE_ACCESS_CODE must match the Worker's ACCESS_CODE.
# It is injected only into POST /profile by the API proxy, never sent to the browser.
# Never put WORKSPACE_ACCESS_CODE, ACCESS_CODE, or LLM credentials in any VITE_ variable.
