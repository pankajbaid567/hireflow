# Copy to .env. Empty API keys keep external integrations unconfigured.
# .env is loaded locally and passed to the API container; never commit it.

# Application and browser
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
LOCAL_STORAGE_PATH=./data
BROWSER_HEADLESS=true
APPLICATION_TIMEOUT_MS=15000

# Local PostgreSQL. Compose overrides DATABASE_URL to the internal db hostname.
# Set POSTGRES_PASSWORD before first Compose startup; use a strong value on servers.
DATABASE_URL=postgresql+psycopg2://postgres:hireflow_local@localhost:5432/hireflow
POSTGRES_PASSWORD=hireflow_local

# LLM provider: groq | gemini | openai | anthropic | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is a supported alternative.
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# In Docker, use http://host.docker.internal:11434 for Ollama on the host.
# Python normal plan/confirmed pipeline only. Keys alone do not opt in.
# Missing/unavailable providers retain grounded source facts and visible warnings.
PYTHON_LLM_TAILORING_ENABLED=false
PYTHON_LLM_PREP_ENABLED=false

# Web search: Tavily preferred when both keys are configured, SerpAPI alternative.
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Email provider: sendgrid | resend. Configure a verified sender for delivery.
EMAIL_PROVIDER=resend
SENDGRID_API_KEY=
RESEND_API_KEY=
# Signed receipt verification (configured in the provider webhook dashboard)
RESEND_WEBHOOK_SECRET=
SENDGRID_WEBHOOK_PUBLIC_KEY=
FROM_EMAIL=hireflow@example.com

# Optional semantic embedding pipeline. Docker requires INSTALL_EMBEDDINGS=true.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_MATCHING_ENABLED=false
# Worker-only embedding inference is separately capped, with lexical fallback.
SEMANTIC_DAILY_TEXT_BUDGET=100
FAISS_INDEX_PATH=./data/faiss_index
INSTALL_EMBEDDINGS=false
SPAM_FILTER_THRESHOLD=0.7

# Frontend development API proxy. Docker serves the frontend and /api together.
VITE_API_URL=/api

# Optional read-only JavaScript source hydration, exact comma-separated hosts only.
DYNAMIC_SOURCE_ENABLED=false
DYNAMIC_SOURCE_HOSTS=
