{
  "name": "hireflow-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@simplewebauthn/server": "14.0.0",
    "fontkit": "2.0.4",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "^22.0.0",
    "miniflare": "5.20261019.1-beta",
    "playwright-core": "^1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.151.3"
  }
}
