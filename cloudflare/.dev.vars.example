# Copy to .dev.vars for local development only. Do not commit actual secrets.
ACCESS_CODE=replace-with-a-long-random-access-code
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:3000/api
GROQ_API_KEY=
GEMINI_API_KEY=
